APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Pilihan cepat untuk pengembangan lokal:
DATABASE_URL=sqlite:///./simponi.db
# Contoh MySQL:
# DATABASE_URL=mysql+pymysql://simponi_user:change-me@127.0.0.1:3306/simponi_db

# Gmail: aktifkan 2-Step Verification lalu buat Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-address@gmail.com
FRONTEND_RESET_URL=http://localhost:5173/reset-password
FRONTEND_VERIFY_URL=http://localhost:5173/verify-email
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opsional: seed akun Admin Pemprov saat aplikasi mulai.
ADMIN_PROVINSI_NIP=3200000000000001
ADMIN_PROVINSI_EMAIL=admin@example.local
ADMIN_PROVINSI_PASSWORD=replace-with-a-unique-password